{
  "name": "genpark-agent-context-compaction-deduplicator-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Long-horizon context window compression and semantic deduplicator eliminating redundant tool outputs and recovering token capacity.",
  "homepage": "https://genpark.ai/mcp",
  "author": "alphaparkinc",
  "category": "agentic-infrastructure",
  "tags": [
    "context-compaction",
    "token-deduplication",
